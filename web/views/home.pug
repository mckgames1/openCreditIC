head
    meta(charset='utf-8')
    meta(http-equiv='X-UA-Compatible', content='IE=edge')
    meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=yes, viewport-fit=cover, user-scalable=no')
    meta(name='description', content='Arcade IC Card Management')
    meta(name='author', content='Yukimi Kazari')
    meta(name="apple-mobile-web-app-capable" content="yes")
    meta(name="apple-mobile-web-app-title" content="OCI")
    meta(name="apple-mobile-web-app-status-bar-style" content="black-translucent")
    meta(content="OCI" property="og:title")
    meta(content="Arcade IC Card Management" property="og:description")
    meta(content=`${config.arcade_name} OCI` property="og:site_name")
    link(rel='apple-touch-icon' sizes='57x57' href='/static/img/apple-icon-57x57.png')
    link(rel='apple-touch-icon' sizes='60x60' href='/static/img/apple-icon-60x60.png')
    link(rel='apple-touch-icon' sizes='72x72' href='/static/img/apple-icon-72x72.png')
    link(rel='apple-touch-icon' sizes='76x76' href='/static/img/apple-icon-76x76.png')
    link(rel='apple-touch-icon' sizes='114x114' href='/static/img/apple-icon-114x114.png')
    link(rel='apple-touch-icon' sizes='120x120' href='/static/img/apple-icon-120x120.png')
    link(rel='apple-touch-icon' sizes='144x144' href='/static/img/apple-icon-144x144.png')
    link(rel='apple-touch-icon' sizes='152x152' href='/static/img/apple-icon-152x152.png')
    link(rel='apple-touch-icon' sizes='180x180' href='/static/img/apple-icon-180x180.png')
    link(rel='icon' type='image/png' sizes='192x192' href='/static/img/android-icon-192x192.png')
    link(rel='icon' type='image/png' sizes='32x32' href='/static/img/favicon-32x32.png')
    link(rel='icon' type='image/png' sizes='96x96' href='/static/img/favicon-96x96.png')
    link(rel='icon' type='image/png' sizes='16x16' href='/static/img/favicon-16x16.png')
    link(rel='manifest' href='/static/manifest.json')
    meta(name='msapplication-TileColor' content='#002fc9')
    meta(name='msapplication-TileImage' content='/static/img/ms-icon-144x144.png')
    meta(name='theme-color' content='#002fc9')


    title #{config.arcade_name} OCI

    link(rel='stylesheet', href='/static/css/bootstrap.min.css')
    link(rel='stylesheet', href='/static/css/fontawesome.min.css')
    link(rel='stylesheet', href='/static/css/all.min.css')
    link(rel='stylesheet', href='/static/css/custom.css')
    script(src='/static/js/jquery.min.js')
    script(src='/static/js/popper.min.js')
    script(src='/static/js/bootstrap.min.js')
    script(src='/static/js/sideloader.js')
    if typeof demoMode !== 'undefined' && demoMode
        style.
            .demo-hidden, #findUserModal, #showUserModel, #showFreePlayModel, #headerDepositFreeplay, #collapseDepositFreeplay, #depositAccordion, #newCardModal #initialBalance, #newCardModal label[for='initialBalance'], #newCardModal #userID, #newCardModal label[for='userID'], #newCardModal #userContact, #newCardModal label[for='userContact'], #newCardModal #userNotes, #newCardModal label[for='cardName'] ~ input:not(#cardNum) { display: none !important; }
        script(src='/static/js/demo-home.js' defer)
body.bg-dark.text-white
    div.background
    div.background-overlay
    div.container.text-center
        h1.mt-5 #{config.arcade_name}
        if typeof demoMode !== 'undefined' && demoMode
            div.alert.alert-warning.mt-3.text-dark DEMO / GERÇEK DONANIM DEĞİL — Sanal kart ve sahte bakiye
            div.card.text-dark.p-3.mt-3
                form#demoLogin
                    label(for='demoUsername') Kullanıcı adı
                    input#demoUsername.form-control(required autocomplete='username')
                    label(for='demoPassword') Parola
                    input#demoPassword.form-control(type='password' required minlength='10' autocomplete='current-password')
                    button#demoLoginButton.btn.btn-primary.mt-2(type='submit') Giriş yap / ilk yönetici oluştur
                details.mt-3.text-left
                    summary Demo personel parolasını yenile
                    p.small Yöneticiden alınan tek kullanımlık kodu kullanın. Gerçek hesaplar için değildir.
                    form#demoResetForm
                        label(for='demoResetUsername') Personel kullanıcı adı
                        input#demoResetUsername.form-control(required autocomplete='username')
                        label(for='demoResetToken') Tek kullanımlık kod
                        input#demoResetToken.form-control(type='password' required minlength='64' maxlength='64' autocomplete='off')
                        label(for='demoResetPassword') Yeni parola (10–256 karakter)
                        input#demoResetPassword.form-control(type='password' required minlength='10' maxlength='256' autocomplete='new-password')
                        label(for='demoResetConfirm') Yeni parola tekrar
                        input#demoResetConfirm.form-control(type='password' required minlength='10' maxlength='256' autocomplete='new-password')
                        button.btn.btn-primary.mt-2(type='submit') Demo parolayı yenile
                p#demoAccount.mt-3.mb-0 Giriş bekleniyor.
                label(for='demoCardChoice') Sanal kart seçimi
                select#demoCardChoice.form-control
                form#demoAttachCardForm.mt-3
                    label(for='demoAttachUid') Seçili hesaba başka sanal kart ekle (yalnız demo)
                    input#demoAttachUid.form-control(required maxlength='128' placeholder='Sanal UID, ör. 00112233' autocomplete='off')
                    button.btn.btn-outline-primary.mt-2(type='submit') Sanal kartı bağla
                p#demoAttachPending.alert.alert-warning.text-dark.mt-2(hidden)
                button#demoAttachRetry.btn.btn-warning(type='button' hidden) Bekleyen kart bağlamayı doğrula
                a.btn.btn-outline-primary.mt-2(href='/phase1/') Makine simülatörüne git
                p#demoNotice(role='status')
                p#demoPendingNotice.alert.alert-warning.text-dark(hidden)
                button#demoRetryTopup.btn.btn-warning(type='button' hidden) Bekleyen yüklemeyi doğrula
            section#demoHistory.card.text-dark.p-3.mt-3.text-left(hidden)
                h2.h5 İşlem geçmişi
                p.small#demoHistoryScope
                div.table-responsive
                    table.table.table-sm.text-dark
                        thead
                            tr
                                th Zaman (UTC)
                                th İşlem
                                th Tutar
                                th İşlem sonrası bakiye
                                th İşlem kimliği
                        tbody#demoHistoryRows
            section#demoAdmin.card.text-dark.p-3.mt-3.text-left(hidden)
                h2.h5 Ayrıntılı demo hareketleri
                p.small Tarihler İstanbul saatine göre, uçlar dahil filtrelenir. Cihaz filtresi yalnız ilgili oyun harcamalarını gösterir; yükleme ve düzeltmeler cihaza bağlı değildir.
                form#demoDetailForm
                    label(for='demoDetailFrom') Başlangıç tarihi
                    input#demoDetailFrom.form-control(type='date' min='1900-01-01' max='9998-12-31')
                    label(for='demoDetailTo') Bitiş tarihi
                    input#demoDetailTo.form-control(type='date' min='1900-01-01' max='9998-12-31')
                    label(for='demoDetailType') İşlem türü
                    select#demoDetailType.form-control
                        option(value='') Tüm türler
                        option(value='topup') Yükleme
                        option(value='game_charge') Oyun harcaması
                        option(value='correction') Düzeltme
                        option(value='refund') İade kaydı
                        option(value='bonus') Bonus kaydı
                        option(value='free_play') Ücretsiz oyun kaydı
                    label(for='demoDetailMachine') Cihaz
                    select#demoDetailMachine.form-control
                        option(value='') Tüm cihazlar
                    button.btn.btn-primary.mt-2(type='submit') Hareketleri göster
                    button#demoDetailCsv.btn.btn-outline-primary.mt-2.ml-2(type='button') Ayrıntılı CSV indir
                p#demoDetailStatus.mt-2(role='status')
                div.table-responsive
                    table.table.table-sm.text-dark
                        thead
                            tr
                                th Zaman (UTC)
                                th İşlem
                                th Tutar (TL)
                                th İşlem sonrası hesap bakiyesi
                                th Cihaz / sanal komut durumu
                                th İşlem kimliği
                        tbody#demoDetailRows
                div
                    button#demoDetailPrevious.btn.btn-outline-secondary(type='button') Önceki sayfa
                    button#demoDetailNext.btn.btn-outline-secondary.ml-2(type='button') Sonraki sayfa
                p.small CSV en fazla 5000 filtrelenmiş kayıt içerir; sınır aşılırsa filtreyi daraltın. İşlem sonrası bakiye, rapor döneminin son bakiyesi değildir.
                h2.h5 Son sanal komutlar
                p.small Son 25 demo komutu gösterilir. Sanal başarı, fiziksel makinenin kredi aldığının kanıtı değildir; belirsiz sonuç otomatik başarı veya iade değildir.
                button#demoPulseRefresh.btn.btn-outline-secondary.mb-2(type='button') Komut geçmişini yenile
                div.table-responsive
                    table.table.table-sm.text-dark
                        thead
                            tr
                                th Zaman (UTC)
                                th Makine
                                th Demo tutarı
                                th Sanal komut durumu
                                th Komut kimliği
                        tbody#demoPulseRows
                h2.h5 Seçili demo kart
                p#demoCardStatus
                button#demoCardLock.btn.btn-warning.mb-3(type='button') Kartı engelle
                h2.h5 Demo personel hesabı oluştur
                form#demoStaffForm
                    label(for='demoStaffUsername') Personel kullanıcı adı
                    input#demoStaffUsername.form-control(required minlength='3' maxlength='64' pattern='[A-Za-z0-9._-]+' autocomplete='off')
                    label(for='demoStaffPassword') Başlangıç parolası (en az 10 karakter)
                    input#demoStaffPassword.form-control(type='password' required minlength='10' autocomplete='new-password')
                    button.btn.btn-primary.mt-2.mb-3(type='submit') Personel oluştur
                h2.h5 Demo personel hesapları
                p.small Erişimi durdurulan personelin mevcut oturumu sona erer. Hesap ve işlem geçmişi korunur.
                ul#demoStaffList.list-unstyled
                h2.h5 Demo parola yenileme kodu oluştur
                p.small Yalnız etkin demo personel için; kod 10 dakika geçerlidir ve bir kez kullanılır. Kodu personele yerel olarak güvenli biçimde iletin.
                form#demoResetIssueForm
                    label(for='demoResetStaff') Personel
                    select#demoResetStaff.form-control(required)
                    label(for='demoResetAdminPassword') Yönetici parolanız
                    input#demoResetAdminPassword.form-control(type='password' required autocomplete='current-password')
                    button.btn.btn-warning.mt-2(type='submit') Tek kullanımlık kod oluştur
                p#demoResetIssueResult.mt-2(role='status')
                h2.h5 Demo işlem özeti
                p#demoTotals
                p.small Yükleme, harcama ve net düzeltme ayrıdır; toplam bakiye tüm demo hesaplarındadır.
                h2.h5 Dönemsel demo oyun harcaması
                p.small İstanbul saati; seçilen tarihi içeren gün, Pazartesi başlayan hafta, ay veya yıl. Boş tarih bugün demektir. Oyun harcaması demo bakiye kesintisidir, gerçek gelir veya fiziksel kredi değildir; yükleme ikinci kez gelir olarak eklenmez.
                label(for='demoReportPeriod') Dönem
                select#demoReportPeriod.form-control
                    option(value='day') Günlük
                    option(value='week') Haftalık
                    option(value='month') Aylık
                    option(value='year') Yıllık
                label.mt-2(for='demoReportDate') Tarih (geçmiş dönem seçimi)
                input#demoReportDate.form-control(type='date' min='1900-01-01' max='9998-12-31')
                button#demoReportCsv.btn.btn-outline-primary.mt-2(type='button') Seçili demo raporunu CSV indir
                p.small CSV dönem özetidir; gerçek gelir veya dönem sonu bakiyesi değildir.
                p#demoReportTotals.mt-2(role='status')
                p#demoReportCommands.small
                p.small Komut durumları rapor açıldığı andaki sanal durumlardır; sonuç belirsiz veya başarısız olabilir ve fiziksel kredi kanıtı değildir. Saat değişiminde tekrar eden saatler aynı çubukta toplanır; atlanan saat sıfır gösterilir.
                div#demoReportChart(aria-label='Dönemsel demo oyun harcaması grafiği')
                h3.h6.mt-3 Cihaz bazında demo oyun harcaması
                ul#demoReportMachines
                h2.h5 Demo bakiye düzeltmesi
                p.small Seçili sanal hesabı etkiler. Bu demo varsayımıdır; gerçek iade veya tahsilat değildir.
                form#demoCorrectionForm
                    label(for='demoCorrectionDirection') Yön
                    select#demoCorrectionDirection.form-control
                        option(value='add') Bakiyeye ekle
                        option(value='subtract') Bakiyeden çıkar
                    label(for='demoCorrectionAmount') Tutar (TL)
                    input#demoCorrectionAmount.form-control(type='number' min='0.01' step='0.01' required)
                    label(for='demoCorrectionReason') Gerekçe (10–1000 karakter)
                    textarea#demoCorrectionReason.form-control(required minlength='10' maxlength='1000')
                    button.btn.btn-warning.mt-2.mb-3(type='submit') Demo düzeltmeyi kaydet
                p#demoCorrectionPending.alert.alert-warning(hidden)
                button#demoCorrectionRetry.btn.btn-warning(type='button' hidden) Bekleyen düzeltmeyi doğrula
                h2.h5 Demo makine ekle
                form#demoCreateMachineForm
                    label(for='demoNewMachineId') Makine kimliği
                    input#demoNewMachineId.form-control(required pattern='[A-Za-z0-9_-]{2,64}' maxlength='64')
                    label(for='demoNewMachineName') Makine adı
                    input#demoNewMachineName.form-control(required maxlength='120')
                    label(for='demoNewMachinePrice') Oyun fiyatı (TL)
                    input#demoNewMachinePrice.form-control(type='number' min='0.01' step='0.01' required)
                    button.btn.btn-primary.mt-2.mb-3(type='submit') Demo makine ekle
                h2.h5 Demo kart okuma süreleri
                p.small Aşağıdaki makine seçimindeki cihaza uygulanır; süren beklemeler değiştirilmez.
                form#demoTimingForm
                    label(for='demoCardRemovedMs') Kartın çekildiğini doğrulama süresi (ms)
                    input#demoCardRemovedMs.form-control(type='number' min='0' max='60000' step='1' required)
                    label(for='demoPaymentCooldownMs') Başarılı ödemeler arası bekleme (ms)
                    input#demoPaymentCooldownMs.form-control(type='number' min='0' max='60000' step='1' required)
                    button.btn.btn-primary.mt-2.mb-3(type='submit') Demo sürelerini kaydet
                h2.h5 Demo LED ayarı
                p.small Aşağıdaki seçili makineye aittir; 0–255 yalnızca sanal parlaklık ölçeğidir. Gerçek LED'e aktarılmaz.
                form#demoLedForm
                    label
                        input#demoLedEnabled(type='checkbox')
                        |  Sanal LED etkin
                    label(for='demoLedBrightness') Sanal parlaklık (0–255)
                    input#demoLedBrightness.form-control(type='number' min='0' max='255' step='1' required)
                    button.btn.btn-primary.mt-2.mb-3(type='submit') Demo LED ayarını kaydet
                p#demoSettingsStatus
                h2.h5 Makine ayarları
                form#demoMachineForm
                    label(for='demoMachine') Makine
                    select#demoMachine.form-control(required)
                    label(for='demoMachineName') Makine adı
                    input#demoMachineName.form-control(required maxlength='120')
                    label(for='demoPrice') Oyun fiyatı (TL)
                    input#demoPrice.form-control(type='number' min='0.01' step='0.01' required)
                    label(for='demoPulseMs') Pulse süresi (10–1000 ms)
                    input#demoPulseMs.form-control(type='number' min='10' max='1000' required)
                    label(for='demoPulseCount') Pulse adedi
                    input#demoPulseCount.form-control(type='number' min='1' max='100' required)
                    label(for='demoPulseGap') Darbeler arası boşluk (ms)
                    input#demoPulseGap.form-control(type='number' min='0' max='10000' required)
                    label.mt-2
                        input#demoMachineEnabled(type='checkbox')
                        |  Makine aktif
                    div
                        button.btn.btn-primary.mt-2(type='submit') Ayarları kaydet
        div.btn-group-vertical.mt-5.col-lg-7.rounded.center-menu
            div.w-100
                .form-group
                    select#posTerminal.form-control.form-control-lg(name='posTerminal')
                        each machine in pos_terminals
                            option(value=machine[0]) #{(machine[1].name) ? machine[1].name : machine[0]}#{(machine[1].location) ? ' (' + machine[1].location + ')' : ''}
            div.btn-group.btn-group-lg.flex-column.flex-sm-row.bg-success.rounded
                a.btn(href='#', data-toggle='modal', data-target='#newCardModal').py-4.col.text-white
                    div.d-flex.justify-content-center
                        div.d-flex.align-items-center.justify-content-center.pr-2
                            i.fas.fa-credit-card
                        span Register
                a.btn(href='#', data-toggle='modal', data-target='#depositModal').py-4.col.text-white
                    div.d-flex.justify-content-center
                        div.d-flex.align-items-center.justify-content-center.pr-2
                            i.fas.fa-coins
                        span Deposit
            div.btn-group.btn-group-lg.mt-2(class=(typeof demoMode !== 'undefined' && demoMode ? 'demo-hidden' : ''))
                a.btn.btn-info.rounded-left.col.disabled(href='#')
                    div.d-flex.justify-content-center
                        div.d-flex.align-items-center.justify-content-center.pr-2
                            i.fas.fa-list-alt
                        span Bookkeeping
                button.btn.dropdown-toggle.btn-warning.rounded-right.col-sm-3.col-5(type='button' data-toggle='dropdown' aria-haspopup='true' aria-expanded='false')
                    div.d-flex.justify-content-center
                        div.d-flex.align-items-center.justify-content-center.pr-2
                            i.fas.fa-cog
                        span Tools
                .dropdown-menu
                    .dropdown-header Manage Customers
                    .dropdown-divider
                    a.dropdown-item(href='#', data-toggle='modal', data-target='#findUserModal') Get/Update
                    a.dropdown-item(href='#' onclick='transferCard(); return false;') Card Transfer
                    if (config.show_delete_actions)
                        a.dropdown-item.text-danger(href='#' onclick='cardAction("/delete/scan/card"); return false;') Delete Card
                        a.dropdown-item.text-danger(href='#' onclick='cardAction("/delete/scan/user"); return false;') Delete User
                    .dropdown-header Arcade Management
                    .dropdown-divider
                    a.dropdown-item(href='#' onclick='getFreePlay(); return false;') Free Play
        div.w-100.mt-3.row.justify-content-center
            each machine in machine_dispense
                .col-xl-4.col-md-6.mb-3
                    .card.text-white.bg-dark
                        .row.card-header.align-items-center.p-2.m-0.d-flex(class=`${(machine.last.time >= (Date.now().valueOf() - 60 * 60000)) ? 'bg-success' : 'bg-transparent text-dark'}`)
                            .col.small.text-white.d-flex.p-0.align-items-center
                                i.fas.fa-gamepad(style="padding-right: 0.5em")
                                span #{(machine.info && machine.info.name) ? machine.info.name : machine.id}
                            .col-auto.d-flex.p-0.align-items-center
                        .card-body.position-relative.w-100.h-100.align-items-start.d-flex.flex-column(style=`padding: 0.7em;`)
                            div
                                i.fas.fa-user.pr-2
                                span #{(machine.last.user_info && machine.last.user_info.name) ? machine.last.user_info.name : machine.last.user}
                            if (machine.last.user_b2b > 1)
                                div
                                    i.fas.fa-chart-pie.pr-2
                                    span.pr-1 #{machine.last.user_b2b}x (#{machine.last.user_total_time}) =
                                    if (db.credit_to_currency_rate)
                                        i.fas.fa-yen-sign.pr-1
                                    span #{(db.credit_to_currency_rate) ? machine.last.user_total_profit * db.credit_to_currency_rate : (machine.last.user_total_profit + 'Credit(s)')}
                            div.d-inline-flex.align-items-center
                                i.fas.fa-money-bill.pr-2
                                if (machine.last.free_play)
                                    div.badge.badge-success.text-gray-900
                                        span.font-weight-bold Free Play
                                else
                                    if (db.credit_to_currency_rate)
                                        i.fas.fa-yen-sign.pr-1
                                    span #{(db.credit_to_currency_rate) ? machine.last.cost * db.credit_to_currency_rate : (machine.last.cost.toString() + 'Credit(s)')}
                            div
                                i.fas.fa-clock-four.pr-2
                                span #{machine.last.time_pretty}

                        .card-footer.position-relative.w-100.h-100.bg-translucent.d-flex.justify-content-between.border-top-0(style=`padding: 0.7em;`)
                            div
                                i.fas.fa-users.pr-2
                                span #{machine.today.users.length}
                            div
                                if (db.credit_to_currency_rate)
                                    i.fas.fa-yen-sign.pr-1
                                else
                                    i.fas.fa-coins
                                span #{(db.credit_to_currency_rate) ? machine.today.profit * db.credit_to_currency_rate : (machine.today.profit + 'Credit(s)')}

    div.modal#newCardModal(tabindex='-1' role='dialog')
        div.modal-dialog.text-dark
            div.modal-content
                div.modal-header.bg-success.text-white.py-2
                    h5.modal-title #{typeof demoMode !== 'undefined' && demoMode ? 'Demo hesap ve sanal kart oluştur' : 'Register Customer'}
                    button.close(type='button', data-dismiss='modal')
                        span &times;
                div.modal-body
                    #registerAccordion
                        .form-group
                            label(for='initialBalance') Initial Balance:
                            input#initialBalance.form-control.form-control-lg(type='number', name='initialBalance', placeholder="0 Credits")
                        .card
                            #headerUserInfo.card-header
                                h5.mb-0
                                    button.p-0.btn.btn-link(data-toggle='collapse' data-target='#collapseUserInfo' aria-expanded='true' aria-controls='collapseUserInfo')
                                        div.d-flex.justify-content-center
                                            div.d-flex.align-items-center.justify-content-center.pr-2
                                                i.fas.fa-user-cog
                                            span Customer Info
                            #collapseUserInfo.collapse.show(aria-labelledby='headerUserInfo' data-parent='#registerAccordion')
                                .card-body
                                    .form-group
                                        label(for='userID') Customer ID:
                                        input#userID.form-control(type='text', name='cardName', placeholder="Leave blank for random")
                                    .form-group
                                        label(for='userName') Customer Name:
                                        input#userName.form-control(type='text', name='cardName', placeholder="Customer Name")
                                    .form-group
                                        label(for='userContact') Contact Info:
                                        input#userContact.form-control(type='text', name='cardName', placeholder="Name, Phone Number, Etc.")
                                    .form-group
                                        label(for='userContact') Notes:
                                        textarea#userNotes.form-control(rows=3, name='userNotes', placeholder="")
                        .card
                            #headingTwo.card-header
                                h5.mb-0
                                    button.p-0.btn.btn-link.collapsed(data-toggle='collapse' data-target='#collapseTwo' aria-expanded='false' aria-controls='collapseTwo')
                                        div.d-flex.justify-content-center
                                            div.d-flex.align-items-center.justify-content-center.pr-2
                                                i.fas.fa-credit-card
                                            span Card Info
                            #collapseTwo.collapse(aria-labelledby='headingTwo' data-parent='#registerAccordion')
                                .card-body
                                    .form-group
                                        label(for='cardName') Serial Number:
                                        input#cardNum.form-control(type='text', name='cardName', placeholder=(typeof demoMode !== 'undefined' && demoMode ? 'Sanal kart UID (ör. 00112233)' : 'Leave blank to Scan'))
                                    .form-group
                                        label(for='cardName') Card Name:
                                        input#cardName.form-control(type='text', name='cardName', placeholder="Friendly name for card")
